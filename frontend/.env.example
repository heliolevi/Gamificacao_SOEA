# Copie para .env.local (não versionar).
# Endereço do backend FastAPI. O Next repassa /api/* para cá (mesma origem, cookie seguro).
API_URL=http://127.0.0.1:8000

# 1 = modo demonstração (dados fictícios, sem backend). Deixe vazio para usar o backend real.
NEXT_PUBLIC_DEMO=

# Opcional: Cloudflare Turnstile (chave pública do site; a secreta vai no backend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Opcional: cena 3D do Spline (.splinecode). Sem ela, usa o logo em Three.js.
NEXT_PUBLIC_SPLINE_SCENE=
