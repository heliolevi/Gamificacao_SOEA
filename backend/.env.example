# Copie para .env e preencha. NUNCA versione o .env.
ENV=development                      # production no deploy

# Banco de dados — escolha UM:
# (a) Postgres direto (Neon, Railway, Render, Docker, local). Cole a connection string:
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# (b) Supabase — deixe DATABASE_URL vazio e use a chave de SERVIDOR (sb_secret_...)
SUPABASE_URL=
SUPABASE_KEY=

# Gere cada um com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OTP_PEPPER=

# E-mail: use BREVO_API_KEY (grátis, 300/dia, sem domínio próprio) OU RESEND_API_KEY. Sem nenhuma, em desenvolvimento o código aparece no terminal do uvicorn.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=SOEA <e-mail-verificado-como-remetente@exemplo.com>

# Endereço público do app (usado nos QR Codes e no CORS)
PUBLIC_APP_URL=https://qr-code-hunt.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,https://qr-code-hunt.vercel.app

# Cookie do refresh token. Em localhost via http, use COOKIE_SECURE=false.
COOKIE_SECURE=true
COOKIE_PATH=/api/auth

# Opcional: Cloudflare Turnstile (anti-robô no cadastro e na recuperação de senha)
TURNSTILE_SECRET=

# Power BI: chave de LEITURA para /bi/participantes e /bi/capturas. Vazia = rotas desligadas (404).
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
BI_API_KEY=
